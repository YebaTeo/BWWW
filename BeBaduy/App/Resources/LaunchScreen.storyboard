<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="25098" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="25073"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <layoutGuides>
                        <viewControllerLayoutGuide type="top" id="8WQ-1G-PZ4"/>
                        <viewControllerLayoutGuide type="bottom" id="MTg-3q-3IP"/>
                    </layoutGuides>
                    <view key="view" clipsSubviews="YES" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="LaunchSplashBackground.jpg" translatesAutoresizingMaskIntoConstraints="NO" id="splash-background">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchSplashWaves.png" translatesAutoresizingMaskIntoConstraints="NO" id="footer">
                                <rect key="frame" x="0.0" y="635.85" width="393" height="216.15"/>
                            </imageView>
                            <view userInteractionEnabled="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="brand-lockup">
                                <rect key="frame" x="93" y="347.88" width="201" height="54"/>
                                <subviews>
                                    <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchSplashRice.png" translatesAutoresizingMaskIntoConstraints="NO" id="logo">
                                        <rect key="frame" x="0.0" y="0.0" width="54" height="54"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="54" id="logo-height"/>
                                            <constraint firstAttribute="width" constant="54" id="logo-width"/>
                                        </constraints>
                                    </imageView>
                                    <label userInteractionEnabled="NO" contentMode="scaleToFill" text="BeBaduy" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="wordmark">
                                        <rect key="frame" x="58" y="6.5" width="143" height="41"/>
                                        <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <fontDescription key="fontDescription" type="boldSystem" pointSize="34"/>
                                        <color key="textColor" red="0.357" green="0.396" blue="0.114" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                    </label>
                                </subviews>
                                <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <constraints>
                                    <constraint firstItem="logo" firstAttribute="leading" secondItem="brand-lockup" secondAttribute="leading" id="logo-leading"/>
                                    <constraint firstItem="logo" firstAttribute="top" secondItem="brand-lockup" secondAttribute="top" id="logo-top"/>
                                    <constraint firstItem="logo" firstAttribute="bottom" secondItem="brand-lockup" secondAttribute="bottom" id="logo-bottom"/>
                                    <constraint firstItem="wordmark" firstAttribute="leading" secondItem="logo" secondAttribute="trailing" constant="4" id="wordmark-leading"/>
                                    <constraint firstItem="wordmark" firstAttribute="trailing" secondItem="brand-lockup" secondAttribute="trailing" id="wordmark-trailing"/>
                                    <constraint firstItem="wordmark" firstAttribute="centerY" secondItem="logo" secondAttribute="centerY" id="wordmark-center-y"/>
                                </constraints>
                            </view>
                        </subviews>
                        <color key="backgroundColor" red="0.80" green="0.69" blue="0.63" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="splash-background" firstAttribute="top" secondItem="launch-view" secondAttribute="top" id="splash-background-top"/>
                            <constraint firstItem="splash-background" firstAttribute="bottom" secondItem="launch-view" secondAttribute="bottom" id="splash-background-bottom"/>
                            <constraint firstItem="splash-background" firstAttribute="leading" secondItem="launch-view" secondAttribute="leading" id="splash-background-leading"/>
                            <constraint firstItem="splash-background" firstAttribute="trailing" secondItem="launch-view" secondAttribute="trailing" id="splash-background-trailing"/>
                            <constraint firstItem="footer" firstAttribute="bottom" secondItem="launch-view" secondAttribute="bottom" id="footer-bottom"/>
                            <constraint firstItem="footer" firstAttribute="leading" secondItem="launch-view" secondAttribute="leading" id="footer-leading"/>
                            <constraint firstItem="footer" firstAttribute="trailing" secondItem="launch-view" secondAttribute="trailing" id="footer-trailing"/>
                            <constraint firstItem="footer" firstAttribute="height" secondItem="launch-view" secondAttribute="width" multiplier="0.55" id="footer-height"/>
                            <constraint firstItem="brand-lockup" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" constant="-3" id="lockup-x"/>
                            <constraint firstItem="brand-lockup" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" multiplier="0.88" id="lockup-y"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-376" y="5"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchSplashBackground.jpg" width="538" height="1024"/>
