<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="25098" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="25073"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <layoutGuides>
                        <viewControllerLayoutGuide type="top" id="8WQ-1G-PZ4"/>
                        <viewControllerLayoutGuide type="bottom" id="MTg-3q-3IP"/>
                    </layoutGuides>
                    <view key="view" clipsSubviews="YES" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="OnboardingLogo" translatesAutoresizingMaskIntoConstraints="NO" id="logo">
                                <rect key="frame" x="136.5" y="280.8" width="120" height="120"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="120" id="logo-height"/>
                                    <constraint firstAttribute="width" constant="120" id="logo-width"/>
                                </constraints>
                            </imageView>
                            <label contentMode="scaleToFill" text="BeBaduy" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="wordmark">
                                <rect key="frame" x="143.5" y="414.8" width="106" height="30"/>
                                <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="25"/>
                                <color key="textColor" red="0.30" green="0.25" blue="0.16" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                            </label>
                        </subviews>
                        <color key="backgroundColor" red="0.992" green="0.970" blue="0.942" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="logo" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="logo-x"/>
                            <constraint firstItem="logo" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" multiplier="0.8" id="logo-y"/>
                            <constraint firstItem="wordmark" firstAttribute="centerX" secondItem="logo" secondAttribute="centerX" id="wordmark-x"/>
                            <constraint firstItem="wordmark" firstAttribute="top" secondItem="logo" secondAttribute="bottom" constant="14" id="wordmark-top"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-376" y="5"/>
        </scene>
    </scenes>
    <resources>
        <image name="OnboardingLogo" width="1024" height="1024"/>
    </resources>
</document>
